# Google Gemini API Configuration (for RAG forensic explanations)
# The deterministic warehouse engine executes fully offline without an API key.
# Provide a key only when generating live RAG natural language justifications.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# FastAPI Microservice Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=false

# Frontend Web Dashboard Configuration
VITE_PORT=6969
VITE_API_URL=http://localhost:8000

# Forensic Audit Engine Parameters
AUDIT_STRICT_ADMISSIBILITY=true
TOPOLOGICAL_DAG_ALGORITHM=kahn
